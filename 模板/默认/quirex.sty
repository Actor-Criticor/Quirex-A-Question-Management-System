  \renewcommand{\sBlank}{4cm}%
  \renewcommand{\mBlank}{9cm}%
  \renewcommand{\lBlank}{15cm}%
}

% ============================================
% 十三、题目环境
% ============================================

% --- exercise 环境（习题）---
% 用法: \begin{exercise}[留白档][配图位置]
%   留白档   : SS / S / M / L（默认 M）
%   配图位置 : left / center / right（默认 center）
%              v5 新增。由 meta.figAlign 决定（没设过就按题型推导：解答题靠右），
%              这样「简答题的示意图靠右」这条排版习惯可以由导出层自动带上，
%              也可以在录入时手动改。
% 两个参数都是可选的，所以 \begin{exercise}[M]、\begin{exercise}[M][right]、
% \begin{exercise} 都能用。
\newcounter{exercise}
\counterwithin{exercise}{chapter}
\renewcommand{\theexercise}{\arabic{exercise}}

\newcommand{\mafigalign}{center}%  当前这道题的配图位置

% 注意：这里**必须**用 \NewDocumentEnvironment 而不是 \newenvironment。
% 因为 \newenvironment{...}[2][] 的含义是「1 个可选参数 + 1 个必选参数」，
% 不是「2 个可选参数」—— 用它会把这个 `[` 当成必选参数吃掉，
% 剩下的 `right]` 会**原样排进正文**（踩过）。
% O{默认值} 才是真正的可选参数。
\NewDocumentEnvironment{exercise}{ O{M} O{center} }{%
  \ifthenelse{\equal{#1}{SS}}{%
    \def\thisBlank{\ssBlank}%
    \def\thisNeed{\ssNeed}%
  }{%
    \ifthenelse{\equal{#1}{S}}{%
      \def\thisBlank{\sBlank}%
      \def\thisNeed{\sNeed}%
    }{%
      \ifthenelse{\equal{#1}{L}}{%
        \def\thisBlank{\lBlank}%
        \def\thisNeed{\lNeed}%
      }{%
        \def\thisBlank{\mBlank}%
        \def\thisNeed{\mNeed}%
      }%
    }%
  }%
  % 配图位置：left / center / right（默认 center）
  \renewcommand{\mafigalign}{center}%
  \ifthenelse{\equal{#2}{left}}{\renewcommand{\mafigalign}{left}}{}%
  \ifthenelse{\equal{#2}{right}}{\renewcommand{\mafigalign}{right}}{}%
  \ifthenelse{\boolean{showblank}}{%
    \needspace{\thisNeed}%
  }{}%
  \refstepcounter{exercise}%
  \setcounter{mafig}{0}%          ← v1：图号每题重置
  \par\noindent
  {\bfseries\textcolor{mycolor}{\theexercise.}} \ignorespaces
}{%
  \renewcommand{\mafigalign}{center}%  出题时复位，避免影响后面没写的题
  \ifthenelse{\boolean{showblank}}{%
    \par\vspace{\thisBlank}%
    \vspace{\fill}%
    \filbreak%
  }{%
    \par\vspace{1em}%
  }%
}

% --- example 环境（例题）---
\newcounter{example}
\counterwithin{example}{chapter}
\renewcommand{\theexample}{\arabic{example}}

\newenvironment{example}{%
  \refstepcounter{example}
  \par\noindent
  {\bfseries\textcolor{mycolor}{例\theexample}} \ignorespaces
}{%
  \par\vspace{1em}
}

% --- variation 环境（变式）---
\newcounter{variation}[example]
\renewcommand{\thevariation}{\arabic{variation}}

\newenvironment{variation}{%
  \refstepcounter{variation}
  \par\noindent
  {\bfseries\textcolor{mycolor}{变式\theexample-\thevariation}} \ignorespaces
}{%
  \par\vspace{1em}
}


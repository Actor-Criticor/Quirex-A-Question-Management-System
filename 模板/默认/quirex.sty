\usepackage{circledsteps}
\usepackage{array}

% ============================================
% 四、颜色
% ============================================
\definecolor{mycolor}{HTML}{4A0C6E}
\definecolor{lajiaocolor}{HTML}{9B72B5}

% ============================================
% 五、页面布局
% ============================================
\geometry{top=2cm,bottom=3cm,right=1.8cm,left=1.8cm}

\let\cleardoublepage\clearpage
\setlength{\parindent}{0pt}

% ============================================
% 六、章节样式
% ============================================
\titleformat{\chapter}{\centering\huge\bfseries}{}{1em}{#1}
\titlespacing{\chapter}{0pt}{-50pt}{0pt}

\renewcommand*{\thesection}{\arabic{section}}

\titleformat{\section}
{\normalfont\zihao{-4}\bfseries\raggedright}
{}
{-1em}
{\textcolor{mycolor}{【考点\thesection】 #1}}
\titlespacing{\section}{0pt}{0pt}{12pt}

% ============================================
% 七、目录格式
% ============================================
\titlecontents{chapter}[0pt]{\addvspace{1.5pt}\filright\bf}
                  {\contentspush{\color{mycolor}第\thecontentslabel\ 讲\quad}}
                  {}{\titlerule*[10pt]{.}\contentspage}

% ============================================
% 八、页眉页脚
% ============================================
\pagestyle{fancy}
\fancyhf{}
\fancypagestyle{plain}{%
  \fancyfoot[C]{\thepage}
}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}

% ============================================
% 九、显示开关
% ============================================
\newboolean{showana}
\newboolean{showans}
\newboolean{showcontext}
\newboolean{showlevel}
\newboolean{showres}
\newboolean{showblank}

\setboolean{showres}{true}
\setboolean{showlevel}{true}
\setboolean{showcontext}{true}
\setboolean{showans}{false}
\setboolean{showana}{false}
\setboolean{showblank}{true}

% ============================================
% 十、核心命令
% ============================================

% 答案 —— 带圆角「答案」标签，正文紧随其后（v1：答案与解析已合并）
\newcommand{\ans}[1]{%
  \par\ifthenelse{\boolean{showans}}{%
    \vspace{0.35em}\par\noindent
    \tikz[baseline]{\node[anchor=base,font=\bfseries\color{mycolor},draw=mycolor!90!white,fill=white,rounded corners=0.8em,inner xsep=0.5em,thick,minimum height=1.2ex](T)at(0,0){答案};}%
    \hspace{0.5em}{\kaishu #1}%
  }{}%
}

% 保留给未来使用（例如想恢复「结论 / 详解」区分）
\newcommand{\analysis}[1]{%
  \par\ifthenelse{\boolean{showana}}{%
    \vspace{0.35em}\par\noindent
    \tikz[baseline]{\node[anchor=base,font=\bfseries\color{mycolor},draw=mycolor!90!white,fill=white,rounded corners=0.8em,inner xsep=0.5em,thick,minimum height=1.2ex](T)at(0,0){解析};}%
    \hspace{0.5em}{\kaishu #1}%
  }{}%
}

\newcommand{\memo}[1]{%
  \par\ifthenelse{\boolean{showana}}{%
    \vspace{0.35em}\par\noindent
    \tikz[baseline]{\node[anchor=base,font=\bfseries\color{mycolor},draw=mycolor!90!white,fill=white,rounded corners=0.8em,inner xsep=0.5em,thick,minimum height=1.2ex](T)at(0,0){备注};}%
    \hspace{0.5em}{\kaishu #1}%
  }{}%
}

% 填空题横线
\newcommand{\fillin}{\underline{\hspace{3em}}}

% 选择题括号
\newcommand{\pick}{\mbox{(\quad)}}

% 题源标注（形如「（25全国1 第1题）」）—— 紫色仿宋
\newcommand{\res}[1]{\ifthenelse{\boolean{showres}\AND \boolean{showcontext}}{\textcolor{mycolor}{\fangsong {(#1)}}}{}}

% 题目信息行（v6）—— 题目上方那行小字。
% 装什么由导出时的勾选决定：来源 / 题号 / 难度等级 / 知识点 / 年份，
% 各段之间用「·」分隔（导出程序拼好整串再交给它）。
% 「显示来源」开关（showres）同样管着它：讲义预设里想全关标注，关一个就行。
\newcommand{\qinfo}[1]{\ifthenelse{\boolean{showres}\AND \boolean{showcontext}}{\textcolor{mycolor}{\fangsong {(#1)}}}{}}

% 辣椒图标
\newcommand{\lajiao}{\textcolor{lajiaocolor}{\faPepperHot}}

% 难度（1–5 个辣椒）
\newcommand{\level}[1]{\ifthenelse{\boolean{showlevel}\AND \boolean{showcontext}}{%
    \ifcase#1%
    \or {\lajiao}%
    \or {\lajiao\lajiao}%
    \or {\lajiao\lajiao\lajiao}%
    \or {\lajiao\lajiao\lajiao\lajiao}%
    \or {\lajiao\lajiao\lajiao\lajiao\lajiao}%
    \fi%
  }{}}

% 带圈题号
\newcommand*\cir[1]{\tikz[baseline=(char.base)]{%
    \node[circle,fill=none,draw=mycolor,minimum size=0.5cm,align=center,inner sep=-1.0pt,font=\bfseries\sffamily\footnotesize\color{mycolor}] (char){#1};}
}

% ============================================
% 十一、示意图（v1 新增）
% ============================================
%
% \fig[宽度]{图片文件}
%   · **不浮动**：直接排，绝不用 figure —— 浮动会把图挪到别处、与题分离
%   · 图号每题独立：在 exercise 开始时重置计数器，所以「图1」永远指本题第 1 张示意图
%     （这样无论题目在讲义里怎么排序，网页与 PDF 的图号都一致）
%   · 宽度默认 0.3\linewidth
%   · **位置**由 \mafigalign 决定（exercise 的第二个参数设的）：left / center / right。
%     习惯上解答题的示意图靠右，所以导出层会按 meta.figAlign 自动带上。
%
% 实现说明：把「图 + 图号」装进一个 minipage（这样两者不会分家、宽度精确），
% 再用 \makebox[\linewidth][l|c|r] 把这个整体摆到左边/中间/右边。
%
% 为什么不用 \hfill 夹在两边那种写法：
%   段落最后一行的右侧除了 \hfill 还会叠上 \parfillskip（默认 0pt plus 1fil），
%   于是右边有两个 fil、左边只有一个 —— 「居中」会被推成**靠右**。
%   （这个坑我实打实踩过：日志里 \mafigalign=center，图却贴在右边。）
%   \makebox 的位置参数是精确摆放，没有这类粘连问题。
\newcounter{mafig}

% 图 + 图号的本体（#1 = 宽度比例，#2 = 文件名）
\newcommand{\mafiginner}[2]{%
  \begin{minipage}{#1\linewidth}%
    \centering
    \includegraphics[width=\linewidth]{#2}\\[0.2em]%
    {\small\color{mycolor}图\themafig}%
  \end{minipage}%
}

\newcommand{\fig}[2][0.3]{%
  \par\vspace{0.4em}%
  \refstepcounter{mafig}%
  \noindent
  \ifthenelse{\equal{\mafigalign}{right}}{%
    \makebox[\linewidth][r]{\mafiginner{#1}{#2}}%
  }{%
    \ifthenelse{\equal{\mafigalign}{left}}{%
      \makebox[\linewidth][l]{\mafiginner{#1}{#2}}%
    }{%
      \makebox[\linewidth][c]{\mafiginner{#1}{#2}}%
    }%
  }%
  \par\vspace{0.3em}%
}

% ============================================
% 十二、分页与留白
% ============================================
\newcommand{\ssBlank}{0cm}
\newcommand{\sBlank}{3cm}
\newcommand{\mBlank}{7cm}
\newcommand{\lBlank}{12cm}

\newcommand{\ssNeed}{4\baselineskip}
\newcommand{\sNeed}{8\baselineskip}
\newcommand{\mNeed}{14\baselineskip}
\newcommand{\lNeed}{20\baselineskip}

\newcommand{\compactLayout}{%
  \renewcommand{\ssBlank}{0cm}%
  \renewcommand{\sBlank}{2cm}%
  \renewcommand{\mBlank}{5cm}%
  \renewcommand{\lBlank}{9cm}%
}
\newcommand{\normalLayout}{%
  \renewcommand{\ssBlank}{0cm}%
  \renewcommand{\sBlank}{3cm}%
  \renewcommand{\mBlank}{7cm}%
  \renewcommand{\lBlank}{12cm}%
}
\newcommand{\spaciousLayout}{%
